---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const navLinks = [
  { name: 'Services', href: `${baseUrl}services` },
  { name: 'Locations', href: `${baseUrl}locations` },
  { name: 'About', href: `${baseUrl}about` },
  { name: 'Contact', href: `${baseUrl}contact` },
];
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md border-b border-ink/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href={baseUrl} class="flex items-center gap-3 group focus:outline-none">
      <img 
        src={`${baseUrl}assets/logo-mark.svg`} 
        alt="Evans Mathibe Agency Mark" 
        class="w-9 h-9 transition-transform duration-300 group-hover:rotate-12" 
      />
      <div class="flex flex-col">
        <span class="font-display font-bold text-lg leading-tight tracking-tight text-ink group-hover:text-ember transition-colors">
          EVANS MATHIBE
        </span>
        <span class="text-[10px] font-mono tracking-widest text-slate uppercase">
          Agency & Architect
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-8">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="font-sans text-sm font-medium text-ink/80 hover:text-ember transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-ember hover:after:w-full after:transition-all after:duration-300"
        >
          {link.name}
        </a>
      ))}
      
      <a 
        href={`${baseUrl}contact`} 
        class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-paper bg-ink hover:bg-ember transition-all duration-300 rounded-none border border-ink shadow-[3px_3px_0px_0px_rgba(222,101,109,1)] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px]"
      >
        Book Strategy Call
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <div class="md:hidden flex items-center">
      <button 
        id="mobile-menu-btn" 
        type="button" 
        aria-label="Toggle navigation menu"
        class="p-2 text-ink hover:text-ember focus:outline-none"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div id="mobile-menu" class="hidden md:hidden bg-paper border-b border-ink/10 px-4 pt-2 pb-6 space-y-4">
    {navLinks.map((link) => (
      <a 
        href={link.href} 
        class="block font-display text-lg text-ink hover:text-ember transition-colors py-2 border-b border-ink/5"
      >
        {link.name}
      </a>
    ))}
    <a 
      href={`${baseUrl}contact`} 
      class="block text-center w-full mt-4 px-5 py-3 text-xs font-semibold uppercase tracking-wider text-paper bg-ink hover:bg-ember transition-colors"
    >
      Book Strategy Call
    </a>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (menuBtn && mobileMenu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.length;
        iconClose.classList.remove('hidden');
      }
    });
  }
</script>
