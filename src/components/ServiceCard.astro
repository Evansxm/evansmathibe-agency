---
interface Props {
  title: string;
  shortTitle: string;
  positionLine: string;
  deliverables: string[];
  slug: string;
  order?: number;
}

const { title, positionLine, deliverables, slug, order = 1 } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<a 
  href={`${baseUrl}services/${slug}`} 
  class="group block bg-paper p-8 border-2 border-ink hover:border-ember transition-all duration-300 relative shadow-[4px_4px_0px_0px_rgba(27,23,18,1)] hover:shadow-[8px_8px_0px_0px_rgba(222,101,109,1)] hover:-translate-y-1"
>
  <div class="flex items-center justify-between mb-4">
    <span class="font-mono text-xs font-bold text-slate/70 tracking-widest uppercase">
      // 0{order}
    </span>
    <span class="text-ember opacity-0 group-hover:opacity-100 transition-opacity transform group-hover:translate-x-1 duration-300">
      &rarr;
    </span>
  </div>

  <h3 class="font-display text-2xl font-bold text-ink group-hover:text-ember transition-colors mb-3">
    {title}
  </h3>

  <p class="text-sm font-sans text-slate leading-relaxed mb-6">
    {positionLine}
  </p>

  <div class="space-y-1.5 border-t border-ink/10 pt-4">
    <span class="text-[11px] font-mono font-semibold tracking-wider text-ink uppercase block mb-2">
      Deliverables Include:
    </span>
    {deliverables.slice(0, 3).map((item) => (
      <div class="flex items-center gap-2 text-xs font-sans text-ink/80">
        <span class="w-1.5 h-1.5 bg-ember rounded-full"></span>
        <span>{item}</span>
      </div>
    ))}
  </div>
</a>
