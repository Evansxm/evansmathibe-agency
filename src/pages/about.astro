---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const principles = [
  {
    title: "Architectural Precision",
    description: "Every visual system, campaign, or software pipeline is built with deliberate structure, scalability, and corporate governance in mind."
  },
  {
    title: "High-Velocity AI Integration",
    description: "We don't treat AI as a gimmick. We build custom generative and automated workflows that expand team capacity by orders of magnitude."
  },
  {
    title: "Commercial Integrity",
    description: "Creative brilliance without measurable commercial output is art. We deliver high-conversion assets designed for business growth and ROI."
  },
  {
    title: "African Global Standard",
    description: "Grounded in South Africa's economic heartland, our output measures up to world-class standards across multinational markets."
  }
];
---

<Layout 
  title="About Evans Mathibe Agency | Creative Direction & Enterprise AI Architect"
  description="Learn about Evans Mathibe Agency's philosophy, leadership, and synthesized multi-agent agency model operating across South Africa and globally."
>
  <section class="bg-paper py-16 sm:py-24 border-b border-ink/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs font-mono font-bold tracking-widest text-ember uppercase">
            // Agency DNA & Leadership
          </span>
          <h1 class="font-display text-4xl sm:text-6xl font-bold text-ink leading-tight">
            Bridging High-End Strategy with <span class="font-serif italic text-ember font-normal">Automated Velocity</span>
          </h1>
          <p class="font-sans text-lg text-slate leading-relaxed">
            Evans Mathibe Agency operates at the convergence of architectural creative direction, brand systems design, and enterprise AI automation.
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-ink text-paper p-8 border-2 border-ink shadow-[8px_8px_0px_0px_rgba(222,101,109,1)] space-y-4">
            <span class="text-xs font-mono text-brass font-bold uppercase tracking-widest block">Founder & Lead Architect</span>
            <h2 class="font-display text-3xl font-bold text-paper">Evans Mathibe</h2>
            <p class="text-sm font-sans text-paper/80 leading-relaxed">
              Pioneering multi-agent creative orchestration, enterprise asset management frameworks, and brand strategy across South African commercial centers and international client ecosystems.
            </p>
            <div class="pt-2 flex items-center justify-between text-xs font-mono text-paper/60 border-t border-paper/15">
              <span>SANDTON / JHB HQ</span>
              <span class="text-ember">ACTIVE MANDATE</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- PRINCIPLES GRID -->
  <section class="py-20 bg-paper/60 border-b border-ink/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-mono font-bold tracking-widest text-brass uppercase">// Operating Philosophy</span>
        <h2 class="font-display text-3xl sm:text-5xl font-bold text-ink mt-2">Core Guiding Principles</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {principles.map((p, idx) => (
          <div class="bg-paper p-8 border-2 border-ink shadow-[4px_4px_0px_0px_rgba(27,23,18,1)]">
            <span class="font-mono text-xs font-bold text-ember block mb-2">// 0{idx + 1}</span>
            <h3 class="font-display text-2xl font-bold text-ink mb-3">{p.title}</h3>
            <p class="text-sm font-sans text-slate leading-relaxed">{p.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-ink text-paper text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-6">
      <h2 class="font-display text-3xl sm:text-5xl font-bold text-paper">
        Experience the Agency Advantage
      </h2>
      <p class="text-sm sm:text-base text-paper/80 max-w-xl mx-auto">
        Whether launching a corporate repositioning campaign or automating content workflows, our team is equipped to deliver.
      </p>
      <div>
        <a 
          href={`${baseUrl}contact`}
          class="inline-block px-8 py-4 bg-paper text-ink font-sans text-xs font-bold uppercase tracking-widest hover:bg-ember hover:text-paper transition-all border border-paper"
        >
          Get In Touch &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
