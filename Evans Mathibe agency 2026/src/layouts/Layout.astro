---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
}

const { title, description, image = '/logo.png', canonicalUrl } = Astro.props;
const siteUrl = 'https://evansxm.github.io/evansmathibe-agency';
const url = canonicalUrl || `${siteUrl}${Astro.url.pathname.replace(/^\/evansmathibe-agency/, '') || '/'}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Evans Mathibe" />
    <meta name="keywords" content="Evans Mathibe, advertising, media, design, AI automation, Johannesburg, South Africa, creative agency" />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
    <link rel="canonical" href={url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EvansMathibe" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <title>{title} | EvansMathibe Agency</title>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "EvansMathibe",
      "url": siteUrl,
      "logo": image,
      "description": description,
      "sameAs": ["https://github.com/Evansxm", "https://instagram.com/EvansMathibe"],
      "address": {"@type": "PostalAddress", "addressCountry": "ZA", "addressLocality": "Johannesburg", "addressRegion": "Gauteng"},
      "areaServed": "South Africa",
      "hasOfferCatalog": {"@type": "OfferCatalog", "name": "Creative Services", "itemListElement": [{"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Advertising"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Media"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Design"}}, {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "AI Automation"}}]},
      "contactPoint": {"@type": "ContactPoint", "telephone": "+27-00-000-0000", "contactType": "sales", "areaServed": "ZA", "availableLanguage": ["en-ZA"]}
    })} />
  </head>
  <body class="bg-[#0A0A0A] text-[#F5F5F5]">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-[#0A0A0A]/90 backdrop-blur-md border-b border-white/5">
      <div class="max-w-7xl mx-auto px-4 md:px-8 h-16 flex items-center justify-between">
        <a href={import.meta.env.BASE_URL + "/"} class="flex items-center gap-2">
          <img src={`${import.meta.env.BASE_URL}/logo.png`} alt="EvansMathibe" class="w-8 h-8 rounded-lg" />
          <span class="font-bold text-white text-sm">EvansMathibe</span>
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href={import.meta.env.BASE_URL + "/"} class="nav-link">Home</a>
          <a href={import.meta.env.BASE_URL + '/services'} class="nav-link">Services</a>
          <a href={import.meta.env.BASE_URL + '/work'} class="nav-link">Work</a>
          <a href={import.meta.env.BASE_URL + '/about'} class="nav-link">About</a>
          <a href="#contact" class="btn-primary text-sm py-2 px-4">Contact</a>
        </div>
        <button id="mobile-menu-btn" class="md:hidden text-white text-xl" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
      <div id="mobile-menu" class="hidden md:hidden bg-[#111111] border-t border-white/5">
        <div class="px-4 py-4 space-y-3">
          <a href={import.meta.env.BASE_URL + "/"} class="block text-[#A0A0A0] hover:text-[#DE656D] transition-colors py-2">Home</a>
          <a href={import.meta.env.BASE_URL + '/services'} class="block text-[#A0A0A0] hover:text-[#DE656D] transition-colors py-2">Services</a>
          <a href={import.meta.env.BASE_URL + '/work'} class="block text-[#A0A0A0] hover:text-[#DE656D] transition-colors py-2">Work</a>
          <a href={import.meta.env.BASE_URL + '/about'} class="block text-[#A0A0A0] hover:text-[#DE656D] transition-colors py-2">About</a>
          <a href="#contact" class="block text-[#A0A0A0] hover:text-[#DE656D] transition-colors py-2">Contact</a>
        </div>
      </div>
    </nav>
    <slot />
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => menu.classList.toggle('hidden'));
    }
  });
</script>

<style>
  .nav-link { color: #A0A0A0; transition: color 200ms ease; font-size: 0.875rem; font-weight: 500; }
  .nav-link:hover { color: #DE656D; }
  .nav-link.active { color: #DE656D; }
</style>