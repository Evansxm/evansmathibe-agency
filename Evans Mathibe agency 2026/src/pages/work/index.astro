---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Work"
  description="Explore EvansMathibe's portfolio of advertising campaigns, media projects, design systems, and AI automation solutions. Johannesburg-based creative firm."
  image="/logo.png"
>
  <section id="work" class="py-20 md:py-28 px-4 md:px-8 max-w-7xl mx-auto">
    <div class="text-center mb-16 md:mb-20">
      <p class="text-[#DE656D] font-semibold text-sm uppercase tracking-[0.2em] mb-4">Portfolio</p>
      <h2 class="section-title">Work That Speaks for Itself</h2>
      <div class="w-20 h-1 bg-[#DE656D] mx-auto mt-6 rounded-full"></div>
      <p class="section-subtitle mt-6">Advertising campaigns, media ecosystems, brand identities, and intelligent automation systems — each project reflecting a unique intersection of disciplines.</p>
    </div>

    <!-- Filter Tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      <button class="filter-btn active tag text-sm py-2 px-4 cursor-pointer" data-filter="all">All</button>
      <button class="filter-btn tag text-sm py-2 px-4 cursor-pointer" data-filter="advertising">Advertising</button>
      <button class="filter-btn tag text-sm py-2 px-4 cursor-pointer" data-filter="media">Media</button>
      <button class="filter-btn tag text-sm py-2 px-4 cursor-pointer" data-filter="design">Design</button>
      <button class="filter-btn tag text-sm py-2 px-4 cursor-pointer" data-filter="ai-automation">AI Automation</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="project-grid">
      <!-- Project 1: Advertising -->
      <div class="project-card glass-card group overflow-hidden" data-category="advertising">
        <div class="w-full aspect-[4/3] overflow-hidden">
          <img src="/images/10580.jpeg" alt="Campaign Launch" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
        </div>
        <div class="p-6">
          <div class="flex gap-2 mb-3">
            <span class="tag">Advertising</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Campaign Launch: Q4 Visibility Push</h3>
          <p class="text-[#A0A0A0] text-sm mb-3">A cross-channel advertising campaign that increased brand recall by 38% across Gauteng.</p>
          <p class="text-[#DE656D] font-semibold text-xs">+38% Brand Recall</p>
        </div>
      </div>

      <!-- Project 2: Media -->
      <div class="project-card glass-card group overflow-hidden" data-category="media">
        <div class="w-full aspect-[4/3] overflow-hidden">
          <img src="/images/9579.jpeg" alt="Media Strategy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
        </div>
        <div class="p-6">
          <div class="flex gap-2 mb-3">
            <span class="tag">Media</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Editorial Strategy for Media Brand</h3>
          <p class="text-[#A0A0A0] text-sm mb-3">Built a content ecosystem reaching 2M+ monthly impressions with culturally grounded storytelling.</p>
          <p class="text-[#DE656D] font-semibold text-xs">2M+ Monthly Impressions</p>
        </div>
      </div>

      <!-- Project 3: Design -->
      <div class="project-card glass-card group overflow-hidden" data-category="design">
        <div class="w-full aspect-[4/3] overflow-hidden">
          <img src="/images/10790.jpeg" alt="Brand Identity" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
        </div>
        <div class="p-6">
          <div class="flex gap-2 mb-3">
            <span class="tag">Design</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Brand Identity System</h3>
          <p class="text-[#A0A0A0] text-sm mb-3">Complete visual identity rework including logo, typography, and design system for a Johannesburg brand.</p>
          <p class="text-[#DE656D] font-semibold text-xs">Full Visual Overhaul</p>
        </div>
      </div>

      <!-- Project 4: AI Automation -->
      <div class="project-card glass-card group overflow-hidden" data-category="ai-automation">
        <div class="w-full aspect-[4/3] overflow-hidden">
          <img src="/images/Generated_image_1_-_2025-11-17T184214.269.png" alt="AI Workflow" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
        </div>
        <div class="p-6">
          <div class="flex gap-2 mb-3">
            <span class="tag">AI Automation</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">AI-Powered Design Workflow</h3>
          <p class="text-[#A0A0A0] text-sm mb-3">Custom AI system reducing design iteration time by 40% through automated mockup generation.</p>
          <p class="text-[#DE656D] font-semibold text-xs">-40% Iteration Time</p>
        </div>
      </div>

      <!-- Project 5: Advertising -->
      <div class="project-card glass-card group overflow-hidden" data-category="advertising">
        <div class="w-full aspect-[4/3] overflow-hidden">
          <img src="/images/9640_copy.jpeg" alt="Digital Campaign" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
        </div>
        <div class="p-6">
          <div class="flex gap-2 mb-3">
            <span class="tag">Advertising</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Digital Campaign: Youth Engagement</h3>
          <p class="text-[#A0A0A0] text-sm mb-3">Targeted advertising campaign reaching 500K+ South African youth with measurable engagement.</p>
          <p class="text-[#DE656D] font-semibold text-xs">500K+ Reach</p>
        </div>
      </div>

      <!-- Project 6: Design -->
      <div class="project-card glass-card group overflow-hidden" data-category="design">
        <div class="w-full aspect-[4/3] overflow-hidden">
          <img src="/images/Generated_image_1_-_2025-11-17T183012.280.png" alt="Product Design" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
        </div>
        <div class="p-6">
          <div class="flex gap-2 mb-3">
            <span class="tag">Design</span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Digital Product Design</h3>
          <p class="text-[#A0A0A0] text-sm mb-3">End-to-end product design for a fintech startup, from research to launch-ready interface.</p>
          <p class="text-[#DE656D] font-semibold text-xs">From Research to Launch</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = '';
            card.style.animation = 'fadeIn 0.4s ease';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Add fade-in animation
    const style = document.createElement('style');
    style.textContent = '@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }';
    document.head.appendChild(style);
  });
</script>