---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="EvansMathibe"
  description="EvansMathibe is a Johannesburg-based creative and technology firm specializing in advertising, media, design, and AI automation. We augment human creativity with intelligent systems."
  image="/logo.png"
>
  <Hero
    title="Creative Amplified by Intelligence"
    subtitle="Advertising, media, design, and AI automation — fused into one operating system for brand growth."
  />
  <Services />
  <About
    title="Bridging Creativity and Intelligence"
    subtitle="A full-service creative and technology firm rooted in Johannesburg, operating at the convergence of human creative instinct and artificial intelligence."
  />
  <Contact
    title="Get In Touch"
    subtitle="Ready to bring your vision to life? Let's collaborate."
  />
  <Footer
    title="EvansMathibe bridges human creativity with artificial intelligence."
    subtitle="Johannesburg-based creative and technology firm specializing in advertising, media, design, and AI automation."
  />
</Layout>