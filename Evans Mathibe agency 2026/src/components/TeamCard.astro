---
const { name, role, description, image } = Astro.props;
---

<div class="glass-card text-center group">
  {image && (
    <div class="w-20 h-20 mx-auto mb-4 rounded-full overflow-hidden border-2 border-[#DE656D]/30 group-hover:border-[#DE656D]/60 transition-all duration-300">
      <img src={image} alt={name} class="w-full h-full object-cover" />
    </div>
  )}
  <h3 class="text-xl font-bold text-white mb-1">{name}</h3>
  <p class="text-[#DE656D] font-semibold text-sm mb-2">{role}</p>
  <p class="text-[#A0A0A0] text-sm leading-relaxed">{description}</p>
</div>
