---
const { title, subtitle } = Astro.props;
---

<footer class="bg-[#111111] border-t border-white/5">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img src="/logo.png" alt="EvansMathibe Logo" class="w-10 h-10 rounded-lg" />
          <h3 class="text-xl font-bold text-white">EvansMathibe</h3>
        </div>
        <p class="text-[#A0A0A0] text-sm leading-relaxed">
          {subtitle}
        </p>
        <div class="flex gap-3 mt-6">
          <a href="https://github.com/Evansxm" class="w-10 h-10 bg-[#1A1A1A] rounded-lg flex items-center justify-center text-white hover:bg-[#DE656D] transition-colors border border-white/5" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-[#1A1A1A] rounded-lg flex items-center justify-center text-white hover:bg-[#DE656D] transition-colors border border-white/5" aria-label="Instagram">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-[#1A1A1A] rounded-lg flex items-center justify-center text-white hover:bg-[#DE656D] transition-colors border border-white/5" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">Navigate</h4>
        <ul class="space-y-3">
          <li><a href="/" class="text-[#A0A0A0] hover:text-[#DE656D] transition-colors text-sm">Home</a></li>
          <li><a href="/services" class="text-[#A0A0A0] hover:text-[#DE656D] transition-colors text-sm">Services</a></li>
          <li><a href="/work" class="text-[#A0A0A0] hover:text-[#DE656D] transition-colors text-sm">Work</a></li>
          <li><a href="/about" class="text-[#A0A0A0] hover:text-[#DE656D] transition-colors text-sm">About</a></li>
          <li><a href="/contact" class="text-[#A0A0A0] hover:text-[#DE656D] transition-colors text-sm">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-white mb-4">Disciplines</h4>
        <ul class="space-y-3">
          <li><a href="#advertising" class="text-[#A0A0A0] hover:text-[#DE656D] transition-colors text-sm">Advertising</a></li>
          <li><a href="#media" class="text-[#A0A0A0] hover:text-[#DE656D] transition-colors text-sm">Media</a></li>
          <li><a href="#design" class="text-[#A0A0A0] hover:text-[#DE656D] transition-colors text-sm">Design</a></li>
          <li><a href="#ai-automation" class="text-[#A0A0A0] hover:text-[#DE656D] transition-colors text-sm">AI Automation</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[#A0A0A0] text-sm">&copy; 2026 EvansMathibe. All rights reserved.</p>
      <p class="text-[#A0A0A0] text-xs">Built with Astro &amp; Tailwind CSS. Open source.</p>
    </div>
  </div>
</footer>