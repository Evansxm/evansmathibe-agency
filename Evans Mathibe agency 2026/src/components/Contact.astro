---
const { title = "Get In Touch", subtitle = "Ready to bring your vision to life? Let's collaborate." } = Astro.props;
---

<section id="contact" class="py-20 md:py-28 px-4 md:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-16 md:mb-20">
    <p class="text-[#DE656D] font-semibold text-sm uppercase tracking-[0.2em] mb-4">Get In Touch</p>
    <h2 class="section-title">{title}</h2>
    <div class="w-20 h-1 bg-[#DE656D] mx-auto mt-6 rounded-full"></div>
    <p class="section-subtitle mt-6">{subtitle}</p>
  </div>

  <div class="max-w-2xl mx-auto">
    <div class="bg-[#1A1A1A] rounded-2xl border border-white/10 p-8 md:p-10 glow-primary">
      <form class="space-y-6" action="#" method="POST">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-[#A0A0A0] mb-1" for="name">Your Name</label>
            <input type="text" id="name" name="name" required class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#DE656D] focus:outline-none focus:ring-1 focus:ring-[#DE656D] transition-colors" placeholder="Jane Doe" />
          </div>
          <div>
            <label class="block text-sm font-medium text-[#A0A0A0] mb-1" for="email">Email</label>
            <input type="email" id="email" name="email" required class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#DE656D] focus:outline-none focus:ring-1 focus:ring-[#DE656D] transition-colors" placeholder="jane@agency.com" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-[#A0A0A0] mb-1" for="service">Service Interest</label>
          <select id="service" name="service" required class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#DE656D] focus:outline-none focus:ring-1 focus:ring-[#DE656D] transition-colors">
            <option value="">Select a service</option>
            <option value="advertising">Advertising</option>
            <option value="media">Media</option>
            <option value="design">Design</option>
            <option value="ai-automation">AI Automation</option>
            <option value="other">Other / Consulting</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-[#A0A0A0] mb-1" for="message">Brief Description</label>
          <textarea id="message" name="message" rows="5" required class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#DE656D] focus:outline-none focus:ring-1 focus:ring-[#DE656D] transition-colors resize-none" placeholder="Tell us what you're looking for, your timeline, and what you hope to achieve..."></textarea>
        </div>
        <button type="submit" class="btn-primary w-full text-lg py-4">Send Brief</button>
      </form>
    </div>

    <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="bg-[#1A1A1A] rounded-xl p-6 border border-white/5 text-center">
        <p class="text-[#DE656D] font-bold text-lg mb-1">+27</p>
        <p class="text-[#A0A0A0] text-sm">South Africa</p>
      </div>
      <div class="bg-[#1A1A1A] rounded-xl p-6 border border-white/5 text-center">
        <p class="text-[#DE656D] font-bold text-lg mb-1">@EvansMathibe</p>
        <p class="text-[#A0A0A0] text-sm">Social Media</p>
      </div>
      <div class="bg-[#1A1A1A] rounded-xl p-6 border border-white/5 text-center">
        <p class="text-[#DE656D] font-bold text-lg mb-1">evans@</p>
        <p class="text-[#A0A0A0] text-sm">evansmathibe.com</p>
      </div>
    </div>
  </div>
</section>