---
---

<section id="contact" class="py-20 px-4 md:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="section-title">Get In Touch</h2>
    <div class="w-20 h-1 bg-[#DE656D] mx-auto mt-4 rounded-full"></div>
    <p class="section-subtitle">Ready to bring your vision to life? Let's collaborate.</p>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "mainEntity": {
      "@type": "Organization",
      "name": "EvansMathibe",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+27-00-000-0000",
        "contactType": "sales",
        "areaServed": "ZA",
        "availableLanguage": ["en-ZA"]
      }
    }
  })} />

  <div class="max-w-2xl mx-auto">
    <div class="bg-[#1A1A1A] rounded-2xl border border-white/10 p-8 glow-primary">
      <form class="space-y-6" action="#" method="POST">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-[#A0A0A0] mb-1" for="name">Name</label>
            <input type="text" id="name" name="name" required class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#DE656D] focus:outline-none focus:ring-1 focus:ring-[#DE656D] transition-colors" placeholder="Your Name" />
          </div>
          <div>
            <label class="block text-sm font-medium text-[#A0A0A0] mb-1" for="email">Email</label>
            <input type="email" id="email" name="email" required class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#DE656D] focus:outline-none focus:ring-1 focus:ring-[#DE656D] transition-colors" placeholder="your@email.com" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-[#A0A0A0] mb-1" for="message">Message</label>
          <textarea id="message" name="message" rows="5" required class="w-full bg-[#111111] border border-white/10 rounded-lg px-4 py-3 text-white focus:border-[#DE656D] focus:outline-none focus:ring-1 focus:ring-[#DE656D] transition-colors resize-none" placeholder="Tell us about your project..."></textarea>
        </div>
        <button type="submit" class="btn-primary w-full text-lg">Send Message</button>
      </form>
    </div>

    <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      <div class="bg-[#1A1A1A] rounded-xl p-6 border border-white/5">
        <p class="text-[#DE656D] font-bold text-lg mb-1">+27</p>
        <p class="text-[#A0A0A0] text-sm">South Africa</p>
      </div>
      <div class="bg-[#1A1A1A] rounded-xl p-6 border border-white/5">
        <p class="text-[#DE656D] font-bold text-lg mb-1">@EvansMathibe</p>
        <p class="text-[#A0A0A0] text-sm">Social Media</p>
      </div>
      <div class="bg-[#1A1A1A] rounded-xl p-6 border border-white/5">
        <p class="text-[#DE656D] font-bold text-lg mb-1">evans@</p>
        <p class="text-[#A0A0A0] text-sm">evansmathibe.com</p>
      </div>
    </div>
  </div>
</section>
